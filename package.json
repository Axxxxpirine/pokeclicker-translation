{
  "name": "pokeclicker-translation",
  "version": "0.2.0",
  "private": true,
  "description": "Independent PokéClicker translation userscript, starting with French",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "import": "node tools/import-translations.mjs",
    "audit": "node tools/audit.mjs",
    "build": "node tools/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tools/browser-check.mjs",
    "test:compatibility": "node tools/compatibility-check.mjs"
  },
  "dependencies": {
    "i18next": "21.10.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "esbuild": "0.28.2",
    "jsdom": "25.0.1",
    "knockout": "3.5.1"
  }
}
